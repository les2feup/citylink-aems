{
  "@context": [
    "https://www.w3.org/2022/wot/td/v1.1",
    "https://raw.githubusercontent.com/OWNER/aems-emergency-model/main/context/citylink-aems.context.jsonld"
  ],
  "@type": [
    "tm:ThingModel",
    "AemsMitigationTM"
  ],
  "title": "Emergency Mitigation Unit",
  "description": "Cloud-layer mitigation service for one or more hazard factors. Receives the alarm envelope forwarded unchanged by the EMC and may command actuating EDUs directly, propagating the alarm's priority, device and zone into the mitigation envelope without recalculation.",
  "version": {
    "model": "0.4.0"
  },
  "hazardFactors": "{{HAZARD_FACTORS}}",
  "actions": {
    "handleAlarm": {
      "title": "Handle alarm",
      "description": "Alarm forwarding (S3 -> M1).",
      "input": {
        "tm:ref": "https://raw.githubusercontent.com/OWNER/aems-emergency-model/main/ThingModels/generic/aems_common.tm.json#/properties/alarmEnvelope",
        "required": [
          "messageClass",
          "priority",
          "deviceId",
          "hazardFactor",
          "timestamp",
          "payload"
        ]
      },
      "output": {
        "type": "object",
        "properties": {
          "accepted": {
            "type": "boolean"
          }
        },
        "required": [
          "accepted"
        ]
      }
    }
  }
}
