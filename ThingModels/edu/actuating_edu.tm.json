{
  "@context": [
    "https://www.w3.org/2022/wot/td/v1.1",
    "https://raw.githubusercontent.com/les2feup/citylink-aems/main/context/citylink-aems.context.jsonld"
  ],
  "@type": [
    "tm:ThingModel",
    "AemsActuatingEduTM"
  ],
  "title": "Actuating EDU",
  "description": "Application-layer TM of an actuating EDU. Acts locally (E3) or on command from an EMU through 'mitigate', bound to request-response so the command bypasses any deployment broker queue and does not pass through the EMC. The command carries a mitigation message, whose priority the EDU may use as an input to its local logic; how it arbitrates concurrent commands is not specified by the architecture.",
  "version": {
    "model": "0.5.0"
  },
  "hazardFactors": "{{HAZARD_FACTORS}}",
  "properties": {
    "zone": {
      "tm:ref": "https://raw.githubusercontent.com/les2feup/citylink-aems/main/ThingModels/generic/aems_common.tm.json#/properties/zone",
      "readOnly": true
    },
    "state": {
      "type": "string",
      "enum": [
        "idle",
        "active"
      ],
      "readOnly": true,
      "observable": true
    }
  },
  "actions": {
    "mitigate": {
      "title": "Mitigate",
      "description": "Mitigation (M2 -> E3).",
      "input": {
        "tm:ref": "https://raw.githubusercontent.com/les2feup/citylink-aems/main/ThingModels/generic/aems_common.tm.json#/properties/mitigationMessage"
      },
      "output": {
        "type": "object",
        "properties": {
          "accepted": {
            "type": "boolean"
          }
        },
        "required": [
          "accepted"
        ]
      }
    }
  }
}
