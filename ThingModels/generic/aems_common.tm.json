{
  "@context": [
    "https://www.w3.org/2022/wot/td/v1.1"
  ],
  "@type": "tm:ThingModel",
  "title": "aems_common",
  "description": "Schema library for the a-EMS. These properties are not exposed by any Thing; other Thing Models reference them with tm:ref, following the CityLink common_props pattern. The message formats (monitoring, alarm, mitigation) and priorityAssignment are each defined once here, so every affordance that uses them shares a single definition.",
  "version": {
    "model": "0.5.0"
  },
  "properties": {
    "messageClass": {
      "title": "Message class",
      "description": "Alarm and monitoring events may cross a deployment scheduler; mitigation uses a request-response binding.",
      "type": "string",
      "enum": [
        "monitoring",
        "alarm",
        "mitigation"
      ]
    },
    "priority": {
      "title": "Contextual priority",
      "description": "Scalar priority emitted by firmware. The deployment declares its numeric type, bounds and order; the model does not require CRI, HP or a fuzzy computation as its source.",
      "type": "number"
    },
    "contextualRiskIndex": {
      "title": "Contextual risk index (CRI)",
      "description": "CRI of the zone from the MGA (Multi-Domain Geospatial Assessment) CRI maps, CRI_ent = R * (1 + gamma * E) / (1 + gamma), normalized to [0, 1]. One value per zone, common to all hazard factors.",
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "deviceId": {
      "title": "Device identifier",
      "type": "string"
    },
    "zone": {
      "title": "Zone identifier",
      "description": "Identifier of the zone, the spatial unit of the MGA CRI maps.",
      "type": "string"
    },
    "hazardFactor": {
      "title": "Hazard factor",
      "description": "Vocabulary of hazard factors.",
      "type": "string",
      "enum": [
        "fire",
        "flood",
        "airQuality"
      ]
    },
    "localHazardFactor": {
      "title": "Hazard factor",
      "description": "Hazard factor restricted to the factors of the Thing that declares the affordance.",
      "type": "string",
      "enum": "{{HAZARD_FACTORS}}"
    },
    "epochTimestamp": {
      "title": "Timestamp",
      "description": "Milliseconds since Unix epoch.",
      "type": "integer",
      "minimum": 0
    },
    "priorityAssignment": {
      "title": "Priority assignment",
      "description": "Contextual configuration: zone, CRI and issue instant, returned by configure and received by updatePriority. It does not contain the final emitted priority or a number of priority classes.",
      "type": "object",
      "properties": {
        "zone": {
          "tm:ref": "https://raw.githubusercontent.com/OWNER/aems-emergency-model/main/ThingModels/generic/aems_common.tm.json#/properties/zone"
        },
        "contextualRiskIndex": {
          "tm:ref": "https://raw.githubusercontent.com/OWNER/aems-emergency-model/main/ThingModels/generic/aems_common.tm.json#/properties/contextualRiskIndex"
        },
        "issuedAt": {
          "tm:ref": "https://raw.githubusercontent.com/OWNER/aems-emergency-model/main/ThingModels/generic/aems_common.tm.json#/properties/epochTimestamp",
          "title": "Issued at",
          "description": "Instant at which the EMC issued this CRI value."
        }
      },
      "required": [
        "zone",
        "contextualRiskIndex",
        "issuedAt"
      ]
    },
    "messageHeader": {
      "title": "Message header",
      "description": "Header fields shared by every message class. deviceId and zone refer to the origin of the emergency or observation (the detecting EDU), also in mitigation messages.",
      "type": "object",
      "properties": {
        "messageClass": {
          "tm:ref": "https://raw.githubusercontent.com/OWNER/aems-emergency-model/main/ThingModels/generic/aems_common.tm.json#/properties/messageClass"
        },
        "priority": {
          "tm:ref": "https://raw.githubusercontent.com/OWNER/aems-emergency-model/main/ThingModels/generic/aems_common.tm.json#/properties/priority"
        },
        "deviceId": {
          "tm:ref": "https://raw.githubusercontent.com/OWNER/aems-emergency-model/main/ThingModels/generic/aems_common.tm.json#/properties/deviceId"
        },
        "zone": {
          "tm:ref": "https://raw.githubusercontent.com/OWNER/aems-emergency-model/main/ThingModels/generic/aems_common.tm.json#/properties/zone"
        },
        "hazardFactor": {
          "tm:ref": "https://raw.githubusercontent.com/OWNER/aems-emergency-model/main/ThingModels/generic/aems_common.tm.json#/properties/hazardFactor"
        },
        "timestamp": {
          "tm:ref": "https://raw.githubusercontent.com/OWNER/aems-emergency-model/main/ThingModels/generic/aems_common.tm.json#/properties/epochTimestamp"
        },
        "payload": {
          "type": "object"
        }
      },
      "required": [
        "messageClass",
        "priority",
        "deviceId",
        "zone",
        "hazardFactor",
        "timestamp",
        "payload"
      ]
    },
    "monitoringMessage": {
      "title": "Monitoring message",
      "type": "object",
      "properties": {
        "messageClass": {
          "type": "string",
          "const": "monitoring"
        },
        "priority": {
          "tm:ref": "https://raw.githubusercontent.com/OWNER/aems-emergency-model/main/ThingModels/generic/aems_common.tm.json#/properties/priority"
        },
        "deviceId": {
          "tm:ref": "https://raw.githubusercontent.com/OWNER/aems-emergency-model/main/ThingModels/generic/aems_common.tm.json#/properties/deviceId"
        },
        "zone": {
          "tm:ref": "https://raw.githubusercontent.com/OWNER/aems-emergency-model/main/ThingModels/generic/aems_common.tm.json#/properties/zone"
        },
        "hazardFactor": {
          "tm:ref": "https://raw.githubusercontent.com/OWNER/aems-emergency-model/main/ThingModels/generic/aems_common.tm.json#/properties/localHazardFactor"
        },
        "timestamp": {
          "tm:ref": "https://raw.githubusercontent.com/OWNER/aems-emergency-model/main/ThingModels/generic/aems_common.tm.json#/properties/epochTimestamp"
        },
        "payload": {
          "title": "Observation",
          "description": "Follows the observation structure of SOSA (observed property, result, result time) as plain JSON.",
          "type": "object",
          "properties": {
            "observedProperty": {
              "type": "string"
            },
            "hasSimpleResult": {
              "type": "number"
            },
            "unit": {
              "type": "string"
            },
            "resultTime": {
              "type": "string",
              "format": "date-time"
            }
          },
          "required": [
            "observedProperty",
            "hasSimpleResult",
            "resultTime"
          ]
        }
      },
      "required": [
        "messageClass",
        "priority",
        "deviceId",
        "zone",
        "hazardFactor",
        "timestamp",
        "payload"
      ]
    },
    "alarmMessage": {
      "title": "Alarm message",
      "description": "Emitted by the sensing EDU and forwarded unchanged by the EMC to the EMUs that serve the hazard factor.",
      "type": "object",
      "properties": {
        "messageClass": {
          "type": "string",
          "const": "alarm"
        },
        "priority": {
          "tm:ref": "https://raw.githubusercontent.com/OWNER/aems-emergency-model/main/ThingModels/generic/aems_common.tm.json#/properties/priority"
        },
        "deviceId": {
          "tm:ref": "https://raw.githubusercontent.com/OWNER/aems-emergency-model/main/ThingModels/generic/aems_common.tm.json#/properties/deviceId"
        },
        "zone": {
          "tm:ref": "https://raw.githubusercontent.com/OWNER/aems-emergency-model/main/ThingModels/generic/aems_common.tm.json#/properties/zone"
        },
        "hazardFactor": {
          "tm:ref": "https://raw.githubusercontent.com/OWNER/aems-emergency-model/main/ThingModels/generic/aems_common.tm.json#/properties/localHazardFactor"
        },
        "timestamp": {
          "tm:ref": "https://raw.githubusercontent.com/OWNER/aems-emergency-model/main/ThingModels/generic/aems_common.tm.json#/properties/epochTimestamp"
        },
        "payload": {
          "title": "CAP alert",
          "description": "CAP 1.2 alert kept as an XML string so it stays checkable against the OASIS XSD; the zone CRI and the hazard factor travel as <parameter> entries.",
          "type": "object",
          "properties": {
            "identifier": {
              "type": "string"
            },
            "xml": {
              "type": "string",
              "contentMediaType": "application/cap+xml"
            }
          },
          "required": [
            "identifier",
            "xml"
          ]
        }
      },
      "required": [
        "messageClass",
        "priority",
        "deviceId",
        "zone",
        "hazardFactor",
        "timestamp",
        "payload"
      ]
    },
    "mitigationMessage": {
      "title": "Mitigation message",
      "description": "Sent by an EMU to an actuating EDU. priority, deviceId, zone and hazardFactor refer to the originating emergency and are available for copying from its alarm without recalculation. Command choice and arbitration belong to local mitigation logic, outside the model.",
      "type": "object",
      "properties": {
        "messageClass": {
          "type": "string",
          "const": "mitigation"
        },
        "priority": {
          "tm:ref": "https://raw.githubusercontent.com/OWNER/aems-emergency-model/main/ThingModels/generic/aems_common.tm.json#/properties/priority"
        },
        "deviceId": {
          "tm:ref": "https://raw.githubusercontent.com/OWNER/aems-emergency-model/main/ThingModels/generic/aems_common.tm.json#/properties/deviceId"
        },
        "zone": {
          "tm:ref": "https://raw.githubusercontent.com/OWNER/aems-emergency-model/main/ThingModels/generic/aems_common.tm.json#/properties/zone"
        },
        "hazardFactor": {
          "tm:ref": "https://raw.githubusercontent.com/OWNER/aems-emergency-model/main/ThingModels/generic/aems_common.tm.json#/properties/localHazardFactor"
        },
        "timestamp": {
          "tm:ref": "https://raw.githubusercontent.com/OWNER/aems-emergency-model/main/ThingModels/generic/aems_common.tm.json#/properties/epochTimestamp"
        },
        "payload": {
          "title": "Mitigation command",
          "type": "object",
          "properties": {
            "alarmId": {
              "type": "string",
              "description": "CAP identifier of the alarm being mitigated."
            },
            "command": {
              "type": "string",
              "enum": [
                "activate",
                "deactivate"
              ]
            },
            "issuedBy": {
              "type": "string"
            }
          },
          "required": [
            "alarmId",
            "command"
          ]
        }
      },
      "required": [
        "messageClass",
        "priority",
        "deviceId",
        "zone",
        "hazardFactor",
        "timestamp",
        "payload"
      ]
    }
  }
}
