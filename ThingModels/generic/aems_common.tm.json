{
  "@context": [
    "https://www.w3.org/2022/wot/td/v1.1"
  ],
  "@type": "tm:ThingModel",
  "title": "aems_common",
  "description": "Schema library for the a-EMS. These properties are not exposed by any Thing; other Thing Models reference them with tm:ref, following the CityLink common_props pattern. The class envelopes (monitoring, alarm, mitigation) and priorityAssignment are each defined once here, so every affordance that uses them shares a single definition.",
  "version": {
    "model": "0.3.0"
  },
  "properties": {
    "messageClass": {
      "title": "Message class",
      "description": "TRIAGE/4 reads 'alarm' as its alarm flag; 'monitoring' is routine traffic; 'mitigation' uses a request-response binding and never crosses the fog queue.",
      "type": "string",
      "enum": [
        "monitoring",
        "alarm",
        "mitigation"
      ]
    },
    "priority": {
      "title": "Contextual priority rank",
      "description": "Output class of the contextual priority (CP) computed by the FLC of the EDU that detected the event, per hazard factor, as a rank: Critical = 1, High = 2, Moderate = 3, Low = 4. The classification rule belongs to the CP computation. Rank 1 is the most urgent, as TRIAGE/4 routes ranks <= thetaHigh to its HIGH band.",
      "type": "integer",
      "minimum": 1,
      "maximum": "{{PRIORITY_LEVELS}}"
    },
    "priorityLevels": {
      "title": "Number of priority ranks (N)",
      "description": "Number of CP output classes, defined by the FLC (4), not chosen by the EMC. The EMC returns it at configuration so that its agreement with the scheduler can be checked.",
      "type": "integer",
      "const": "{{PRIORITY_LEVELS}}"
    },
    "contextualRiskIndex": {
      "title": "Contextual risk index (CRI)",
      "description": "CRI of the zone from the MGA (Multi-Domain Geospatial Assessment) CRI maps, CRI_ent = R * (1 + gamma * E) / (1 + gamma), normalized to [0, 1]. One value per zone, common to all hazard factors.",
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "deviceId": {
      "title": "Device identifier",
      "type": "string"
    },
    "zone": {
      "title": "Zone identifier",
      "description": "Identifier of the zone, the spatial unit of the MGA CRI maps.",
      "type": "string"
    },
    "hazardFactor": {
      "title": "Hazard factor",
      "description": "Vocabulary of hazard factors.",
      "type": "string",
      "enum": [
        "fire",
        "flood",
        "airQuality"
      ]
    },
    "localHazardFactor": {
      "title": "Hazard factor",
      "description": "Hazard factor restricted to the factors of the Thing that declares the affordance.",
      "type": "string",
      "enum": "{{HAZARD_FACTORS}}"
    },
    "epochTimestamp": {
      "title": "Timestamp",
      "description": "Milliseconds since Unix epoch.",
      "type": "integer",
      "minimum": 0
    },
    "priorityAssignment": {
      "title": "Priority assignment",
      "description": "Output of the EMC configure action and input of the EDU updatePriority action. The EMC sends it at registration and whenever the CRI of the zone changes; the EDU discards an assignment whose issuedAt is older than the one already applied.",
      "type": "object",
      "properties": {
        "zone": {
          "tm:ref": "https://raw.githubusercontent.com/OWNER/aems-emergency-model/main/ThingModels/generic/aems_common.tm.json#/properties/zone"
        },
        "priorityLevels": {
          "tm:ref": "https://raw.githubusercontent.com/OWNER/aems-emergency-model/main/ThingModels/generic/aems_common.tm.json#/properties/priorityLevels"
        },
        "contextualRiskIndex": {
          "tm:ref": "https://raw.githubusercontent.com/OWNER/aems-emergency-model/main/ThingModels/generic/aems_common.tm.json#/properties/contextualRiskIndex"
        },
        "issuedAt": {
          "tm:ref": "https://raw.githubusercontent.com/OWNER/aems-emergency-model/main/ThingModels/generic/aems_common.tm.json#/properties/epochTimestamp",
          "title": "Issued at",
          "description": "Instant at which the EMC issued this CRI value."
        }
      },
      "required": [
        "zone",
        "priorityLevels",
        "contextualRiskIndex",
        "issuedAt"
      ]
    },
    "envelope": {
      "title": "Message envelope (common header)",
      "description": "Fields shared by every class envelope. deviceId and zone refer to the origin of the emergency or observation (the detecting EDU), also in mitigation messages.",
      "type": "object",
      "properties": {
        "messageClass": {
          "tm:ref": "https://raw.githubusercontent.com/OWNER/aems-emergency-model/main/ThingModels/generic/aems_common.tm.json#/properties/messageClass"
        },
        "priority": {
          "tm:ref": "https://raw.githubusercontent.com/OWNER/aems-emergency-model/main/ThingModels/generic/aems_common.tm.json#/properties/priority"
        },
        "deviceId": {
          "tm:ref": "https://raw.githubusercontent.com/OWNER/aems-emergency-model/main/ThingModels/generic/aems_common.tm.json#/properties/deviceId"
        },
        "zone": {
          "tm:ref": "https://raw.githubusercontent.com/OWNER/aems-emergency-model/main/ThingModels/generic/aems_common.tm.json#/properties/zone"
        },
        "hazardFactor": {
          "tm:ref": "https://raw.githubusercontent.com/OWNER/aems-emergency-model/main/ThingModels/generic/aems_common.tm.json#/properties/hazardFactor"
        },
        "timestamp": {
          "tm:ref": "https://raw.githubusercontent.com/OWNER/aems-emergency-model/main/ThingModels/generic/aems_common.tm.json#/properties/epochTimestamp"
        },
        "payload": {
          "type": "object"
        }
      },
      "required": [
        "messageClass",
        "priority",
        "deviceId",
        "zone",
        "hazardFactor",
        "timestamp",
        "payload"
      ]
    },
    "monitoringEnvelope": {
      "title": "Monitoring envelope",
      "type": "object",
      "properties": {
        "messageClass": {
          "type": "string",
          "const": "monitoring"
        },
        "priority": {
          "tm:ref": "https://raw.githubusercontent.com/OWNER/aems-emergency-model/main/ThingModels/generic/aems_common.tm.json#/properties/priority"
        },
        "deviceId": {
          "tm:ref": "https://raw.githubusercontent.com/OWNER/aems-emergency-model/main/ThingModels/generic/aems_common.tm.json#/properties/deviceId"
        },
        "zone": {
          "tm:ref": "https://raw.githubusercontent.com/OWNER/aems-emergency-model/main/ThingModels/generic/aems_common.tm.json#/properties/zone"
        },
        "hazardFactor": {
          "tm:ref": "https://raw.githubusercontent.com/OWNER/aems-emergency-model/main/ThingModels/generic/aems_common.tm.json#/properties/localHazardFactor"
        },
        "timestamp": {
          "tm:ref": "https://raw.githubusercontent.com/OWNER/aems-emergency-model/main/ThingModels/generic/aems_common.tm.json#/properties/epochTimestamp"
        },
        "payload": {
          "title": "Observation",
          "description": "Follows the observation structure of SOSA (observed property, result, result time) as plain JSON.",
          "type": "object",
          "properties": {
            "observedProperty": {
              "type": "string"
            },
            "hasSimpleResult": {
              "type": "number"
            },
            "unit": {
              "type": "string"
            },
            "resultTime": {
              "type": "string",
              "format": "date-time"
            }
          },
          "required": [
            "observedProperty",
            "hasSimpleResult",
            "resultTime"
          ]
        }
      },
      "required": [
        "messageClass",
        "priority",
        "deviceId",
        "zone",
        "hazardFactor",
        "timestamp",
        "payload"
      ]
    },
    "alarmEnvelope": {
      "title": "Alarm envelope",
      "description": "Emitted by the sensing EDU and forwarded unchanged by the EMC to the EMUs that serve the hazard factor.",
      "type": "object",
      "properties": {
        "messageClass": {
          "type": "string",
          "const": "alarm"
        },
        "priority": {
          "tm:ref": "https://raw.githubusercontent.com/OWNER/aems-emergency-model/main/ThingModels/generic/aems_common.tm.json#/properties/priority"
        },
        "deviceId": {
          "tm:ref": "https://raw.githubusercontent.com/OWNER/aems-emergency-model/main/ThingModels/generic/aems_common.tm.json#/properties/deviceId"
        },
        "zone": {
          "tm:ref": "https://raw.githubusercontent.com/OWNER/aems-emergency-model/main/ThingModels/generic/aems_common.tm.json#/properties/zone"
        },
        "hazardFactor": {
          "tm:ref": "https://raw.githubusercontent.com/OWNER/aems-emergency-model/main/ThingModels/generic/aems_common.tm.json#/properties/localHazardFactor"
        },
        "timestamp": {
          "tm:ref": "https://raw.githubusercontent.com/OWNER/aems-emergency-model/main/ThingModels/generic/aems_common.tm.json#/properties/epochTimestamp"
        },
        "payload": {
          "title": "CAP alert",
          "description": "CAP 1.2 alert kept as an XML string so it stays checkable against the OASIS XSD; the zone CRI and the hazard factor travel as <parameter> entries.",
          "type": "object",
          "properties": {
            "identifier": {
              "type": "string"
            },
            "xml": {
              "type": "string",
              "contentMediaType": "application/cap+xml"
            }
          },
          "required": [
            "identifier",
            "xml"
          ]
        }
      },
      "required": [
        "messageClass",
        "priority",
        "deviceId",
        "zone",
        "hazardFactor",
        "timestamp",
        "payload"
      ]
    },
    "mitigationEnvelope": {
      "title": "Mitigation envelope",
      "description": "Sent by an EMU to an actuating EDU. priority, deviceId, zone and hazardFactor are copied from the alarm without recalculation: the rank measures the urgency of the emergency, not of the actuator's location. Arbitration between concurrent commands belongs to the EDU's local mitigation logic (E3) and is not specified by the architecture.",
      "type": "object",
      "properties": {
        "messageClass": {
          "type": "string",
          "const": "mitigation"
        },
        "priority": {
          "tm:ref": "https://raw.githubusercontent.com/OWNER/aems-emergency-model/main/ThingModels/generic/aems_common.tm.json#/properties/priority"
        },
        "deviceId": {
          "tm:ref": "https://raw.githubusercontent.com/OWNER/aems-emergency-model/main/ThingModels/generic/aems_common.tm.json#/properties/deviceId"
        },
        "zone": {
          "tm:ref": "https://raw.githubusercontent.com/OWNER/aems-emergency-model/main/ThingModels/generic/aems_common.tm.json#/properties/zone"
        },
        "hazardFactor": {
          "tm:ref": "https://raw.githubusercontent.com/OWNER/aems-emergency-model/main/ThingModels/generic/aems_common.tm.json#/properties/localHazardFactor"
        },
        "timestamp": {
          "tm:ref": "https://raw.githubusercontent.com/OWNER/aems-emergency-model/main/ThingModels/generic/aems_common.tm.json#/properties/epochTimestamp"
        },
        "payload": {
          "title": "Mitigation command",
          "type": "object",
          "properties": {
            "alarmId": {
              "type": "string",
              "description": "CAP identifier of the alarm being mitigated."
            },
            "command": {
              "type": "string",
              "enum": [
                "activate",
                "deactivate"
              ]
            },
            "issuedBy": {
              "type": "string"
            }
          },
          "required": [
            "alarmId",
            "command"
          ]
        }
      },
      "required": [
        "messageClass",
        "priority",
        "deviceId",
        "zone",
        "hazardFactor",
        "timestamp",
        "payload"
      ]
    }
  }
}
