{
  "@context": [
    "https://www.w3.org/2022/wot/td/v1.1",
    "https://raw.githubusercontent.com/les2feup/citylink-aems/main/context/citylink-aems.context.jsonld"
  ],
  "@type": [
    "tm:ThingModel",
    "AemsMitigationTM"
  ],
  "title": "Emergency Mitigation Unit",
  "description": "Cloud-layer mitigation service for one or more hazard factors. Receives the alarm message forwarded unchanged by the EMC and may command actuating EDUs directly, propagating the alarm's priority, device and zone into the mitigation message header without recalculation.",
  "version": {
    "model": "0.5.0"
  },
  "hazardFactors": "{{HAZARD_FACTORS}}",
  "actions": {
    "handleAlarm": {
      "title": "Handle alarm",
      "description": "Alarm forwarding (S3 -> M1).",
      "input": {
        "tm:ref": "https://raw.githubusercontent.com/les2feup/citylink-aems/main/ThingModels/generic/aems_common.tm.json#/properties/alarmMessage"
      },
      "output": {
        "type": "object",
        "properties": {
          "accepted": {
            "type": "boolean"
          }
        },
        "required": [
          "accepted"
        ]
      }
    }
  }
}
