{
  "@context": [
    "https://www.w3.org/2022/wot/td/v1.1",
    "https://raw.githubusercontent.com/OWNER/aems-emergency-model/main/context/citylink-aems.context.jsonld"
  ],
  "@type": [
    "tm:ThingModel",
    "AemsSchedulerTM",
    "AemsTriage4SchedulerTM"
  ],
  "title": "TRIAGE/4 Scheduler",
  "description": "Optional deployment specialization describing TRIAGE/4 configuration, not its queue or an integrated runtime. Requires integer priority with lower-first order. Device and geographic zone identity remain separate from priority.",
  "version": {
    "model": "0.4.0"
  },
  "schedulingInput": {
    "type": "object",
    "properties": {
      "messageClass": {
        "type": "string",
        "enum": [
          "alarm",
          "monitoring"
        ]
      },
      "priority": {
        "tm:ref": "https://raw.githubusercontent.com/OWNER/aems-emergency-model/main/ThingModels/generic/aems_common.tm.json#/properties/priority"
      },
      "deviceId": {
        "type": "string"
      },
      "zone": {
        "type": "string"
      },
      "payload": {
        "type": "object"
      }
    },
    "required": [
      "messageClass",
      "priority",
      "deviceId",
      "zone",
      "payload"
    ]
  },
  "properties": {
    "thetaHigh": {
      "title": "theta_H",
      "description": "Ranks <= thetaHigh go to the HIGH band.",
      "type": "integer",
      "const": "{{THETA_HIGH}}",
      "readOnly": true
    },
    "thetaStandard": {
      "title": "theta_S",
      "description": "Ranks in (thetaHigh, thetaStandard] go to STANDARD; above, BACKGROUND.",
      "type": "integer",
      "const": "{{THETA_STANDARD}}",
      "readOnly": true
    }
  }
}
